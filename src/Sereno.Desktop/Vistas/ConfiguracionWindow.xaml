<Window x:Class="Sereno.Desktop.Vistas.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sereno.Desktop.Controles"
        Title="Sereno · Configuración" Style="{StaticResource VentanaSereno}" WindowStartupLocation="CenterScreen"
        Icon="/Recursos/sereno.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="32,28,32,24">
            <c:Marca/>

            <TextBlock Style="{StaticResource Titulo}" Text="Duración de los bloques"/>
            <TextBlock Style="{StaticResource Bajada}"
                       Text="El cambio aplica desde el próximo bloque. Un bloque en curso no se reinicia."/>

            <c:CampoTexto x:Name="Bloque" Etiqueta="Bloque de foco (minutos)" LongitudMaxima="2"
                          Ayuda="Entre 5 y 90 minutos."/>
            <c:CampoTexto x:Name="Pausa" Etiqueta="Pausa (minutos)" LongitudMaxima="2"
                          Ayuda="Entre 1 y 30 minutos."/>

            <TextBlock Style="{StaticResource Etiqueta}" Text="Lectura y visualización" Margin="0,24,0,10"/>
            <CheckBox x:Name="FuenteLectura" Margin="0,0,0,12">
                <TextBlock Text="Fuente para lectura cómoda" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox x:Name="AltoContraste" Margin="0,0,0,12">
                <TextBlock Text="Alto contraste" TextWrapping="Wrap"/>
            </CheckBox>

            <Button Style="{StaticResource BotonPrimario}" Content="Guardar"
                    IsDefault="True" Margin="0,12,0,0" Click="Guardar_Click"/>

            <StackPanel Margin="0,12,0,0">
                <Button Style="{StaticResource BotonEnlace}" Content="Cancelar"
                        IsCancel="True" Click="Cancelar_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
