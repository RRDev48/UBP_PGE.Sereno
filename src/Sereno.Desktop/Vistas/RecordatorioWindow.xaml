<Window x:Class="Sereno.Desktop.Vistas.RecordatorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sereno.Desktop.Controles"
        Title="Sereno"
        Width="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Focusable="False"
        Background="{DynamicResource AvisoFondo}" Foreground="{DynamicResource Texto}"
        BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
        FontFamily="{DynamicResource FuenteBase}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Ventana_Loaded">
    <Grid Margin="16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <c:Mascota Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TextoRestante" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
