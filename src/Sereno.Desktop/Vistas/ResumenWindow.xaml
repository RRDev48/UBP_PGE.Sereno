<Window x:Class="Sereno.Desktop.Vistas.ResumenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sereno.Desktop.Controles"
        Title="Sereno · Resumen de la sesión" Style="{StaticResource VentanaSereno}" WindowStartupLocation="CenterScreen"
        Icon="/Recursos/sereno.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" LayoutTransform="{DynamicResource EscalaVisual}">
        <StackPanel Margin="32,28,32,24">
            <c:Marca/>

            <TextBlock Style="{StaticResource Titulo}" Text="Resumen de la sesión"/>
            <TextBlock Style="{StaticResource Bajada}"
                       Text="Lo que pasó desde que iniciaste sesión. Solo muestra registros, sin calificaciones."/>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource TarjetaPerfil}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="BloquesTexto" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="bloques completados" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaPerfil}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="PausasTexto" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="pausas tomadas" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaPerfil}">
                    <StackPanel>
                        <TextBlock x:Name="PospuestosTexto" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="avisos pospuestos" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource Etiqueta}" Text="Registro"/>
            <ListBox x:Name="Registro" MaxHeight="260" AutomationProperties.Name="Registro de la sesión"
                     Focusable="True" Margin="0,0,0,12"/>
            <TextBlock x:Name="VacioTexto" Style="{StaticResource Ayuda}" Text="Todavía no hay registros."/>

            <WrapPanel Margin="0,4,0,0">
                <Button x:Name="Deshacer" Style="{StaticResource BotonSecundario}"
                        Content="Deshacer el último registro" Margin="0,0,8,8" Click="Deshacer_Click"/>
                <Button Style="{StaticResource BotonPrimario}" Content="Cerrar" IsDefault="True"
                        Margin="0,0,0,8" Click="Cerrar_Click"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Ayuda}"
                       Text="Deshacer quita el registro más reciente. Se puede repetir en orden inverso."/>
        </StackPanel>
    </ScrollViewer>
</Window>
