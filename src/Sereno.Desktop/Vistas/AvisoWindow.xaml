<Window x:Class="Sereno.Desktop.Vistas.AvisoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sereno.Desktop.Controles"
        Title="Sereno · Bloque terminado"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Focusable="False"
        Background="{DynamicResource AvisoFondo}" Foreground="{DynamicResource Texto}"
        BorderBrush="{DynamicResource BordeCampo}" BorderThickness="1"
        FontFamily="{DynamicResource FuenteBase}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Ventana_Loaded">
    <StackPanel Margin="20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <c:Mascota x:Name="MascotaIcono" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TituloTexto" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="CuerpoTexto" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextoSecundario}"/>
            </StackPanel>
        </Grid>
        <WrapPanel Margin="0,14,0,0">
            <Button Style="{StaticResource BotonPrimario}" Content="Empezar pausa"
                    Margin="0,0,8,8" Click="EmpezarPausa_Click"/>
            <Button Style="{StaticResource BotonSecundario}" Content="Posponer 5 minutos (Ctrl+Alt+P)"
                    Margin="0,0,8,8" Click="Posponer_Click"/>
            <Button Style="{StaticResource BotonSecundario}" Content="Descartar (Ctrl+Alt+D)"
                    Margin="0,0,0,8" Click="Descartar_Click"/>
        </WrapPanel>
    </StackPanel>
</Window>
