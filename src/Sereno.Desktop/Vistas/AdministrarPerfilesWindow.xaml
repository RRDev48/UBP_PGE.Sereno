<Window x:Class="Sereno.Desktop.Vistas.AdministrarPerfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sereno.Desktop.Controles"
        Title="Sereno · Administrar perfiles" Style="{StaticResource VentanaSereno}" WindowStartupLocation="CenterScreen"
        Icon="/Recursos/sereno.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" LayoutTransform="{DynamicResource EscalaVisual}">
        <StackPanel Margin="32,28,32,24">
            <c:Marca/>

            <TextBlock Style="{StaticResource Titulo}" Text="Administrar perfiles"/>
            <TextBlock Style="{StaticResource Bajada}"
                       Text="Renombrar o eliminar un perfil de esta computadora. Eliminar borra su carpeta y no se puede deshacer."/>

            <ListBox x:Name="Lista" MaxHeight="280" Margin="0,0,0,4"
                     AutomationProperties.Name="Perfiles de esta computadora">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Nombre}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource BotonEnlace}" Content="Renombrar"
                                    Margin="0,0,8,0" Click="Renombrar_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource BotonEnlace}" Content="Eliminar"
                                    Click="Eliminar_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="VacioTexto" Style="{StaticResource Ayuda}" Text="No hay perfiles en esta computadora."
                       Margin="0,0,0,12" Visibility="Collapsed"/>

            <StackPanel x:Name="PanelRenombrar" Visibility="Collapsed" Margin="0,8,0,4">
                <c:CampoTexto x:Name="NuevoNombre" Etiqueta="Nuevo nombre" LongitudMaxima="40"/>
                <WrapPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource BotonPrimario}" Content="Guardar"
                            Margin="0,0,8,8" Click="GuardarRenombre_Click"/>
                    <Button Style="{StaticResource BotonEnlace}" Content="Cancelar"
                            Margin="0,0,0,8" Click="CancelarRenombre_Click"/>
                </WrapPanel>
            </StackPanel>

            <Border x:Name="PanelEliminar" Visibility="Collapsed" BorderBrush="{DynamicResource Error}"
                    BorderThickness="2" CornerRadius="10" Padding="14" Margin="0,8,0,12">
                <StackPanel>
                    <TextBlock x:Name="EliminarTitulo" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Ayuda}"
                               Text="Se borra la carpeta del perfil, incluida la clave de recuperación. No se puede deshacer."/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource BotonSecundario}" Content="Sí, eliminar"
                                Foreground="{DynamicResource Error}" Margin="0,0,8,8" Click="ConfirmarEliminar_Click"/>
                        <Button Style="{StaticResource BotonPrimario}" Content="Cancelar"
                                Margin="0,0,0,8" Click="CancelarEliminar_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,12,0,0">
                <Button Style="{StaticResource BotonEnlace}" Content="Volver" IsCancel="True" Click="Volver_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
