<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tipografías -->
    <FontFamily x:Key="FuenteBase">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteTitulo">Georgia, Cambria</FontFamily>
    <FontFamily x:Key="FuenteMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FuenteIconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Íconos (viewbox de 24 × 24) -->
    <Geometry x:Key="GeoLuna">M20,14.5 A8,8 0 0 1 9.5,4 A8,8 0 1 0 20,14.5 Z</Geometry>
    <Geometry x:Key="GeoCandado">M5,10 L19,10 L19,20 L5,20 Z M8,10 L8,7 A4,4 0 0 1 16,7 L16,10</Geometry>
    <Geometry x:Key="GeoAviso">M12,3 A9,9 0 1 1 11.99,3 Z M12,7 L12,13 M12,16.5 L12,17</Geometry>
    <Geometry x:Key="GeoTilde">M5,12.5 L9.5,17 L19,7.5</Geometry>

    <!-- Ventana base -->
    <Style x:Key="VentanaSereno" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Fondo}"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FuenteBase}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="460"/>
        <Setter Property="SizeToContent" Value="Height"/>
        <Setter Property="ResizeMode" Value="CanMinimize"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="MaxHeight" Value="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"/>
    </Style>

    <!-- Textos -->
    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Bajada" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Ayuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Marco de los campos de texto: el foco y el error se pintan desde el código. -->
    <Style x:Key="MarcoCampo" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BordeCampo}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource CampoFondo}"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style x:Key="CajaTextoInterna" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="CajaContrasenaInterna" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Botón principal: una sola acción destacada por pantalla. -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FondoPrimario}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoPrimario}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <Border x:Name="Foco" BorderBrush="{DynamicResource Foco}" BorderThickness="3"
                                CornerRadius="11" Margin="-5" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="16,0" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeCampo}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8"/>
                        <Border x:Name="Foco" BorderBrush="{DynamicResource Foco}" BorderThickness="3"
                                CornerRadius="11" Margin="-5" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Separador}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acciones secundarias: menos peso visual, misma área mínima de 44 px. -->
    <Style x:Key="BotonEnlace" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Foco" BorderBrush="{DynamicResource Foco}" BorderThickness="2"
                                CornerRadius="6" Margin="0,6" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextDecorations="Underline" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón para mostrar u ocultar la contraseña. -->
    <Style x:Key="BotonOjo" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Foco" BorderBrush="{DynamicResource Foco}" BorderThickness="2"
                                CornerRadius="6" Margin="4" Visibility="Collapsed"/>
                        <TextBlock x:Name="Abierto" Text="&#xE7B3;" FontFamily="{StaticResource FuenteIconos}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Cerrado" Text="&#xED1A;" FontFamily="{StaticResource FuenteIconos}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Abierto" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Cerrado" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Casilla de 22 px con área clicable de 44 px. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Foco" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Foco}"
                                BorderThickness="2" CornerRadius="6" Margin="-6,2" Visibility="Collapsed"/>
                        <Border x:Name="Caja" Width="22" Height="22" CornerRadius="4" BorderThickness="2"
                                BorderBrush="{DynamicResource BordeCampo}" Background="{DynamicResource CampoFondo}"
                                VerticalAlignment="Center">
                            <Path x:Name="Tilde" Data="{StaticResource GeoTilde}" Stretch="Uniform" Margin="3"
                                  Stroke="{DynamicResource TextoPrimario}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tilde" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Caja" Property="Background" Value="{DynamicResource FondoPrimario}"/>
                            <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource FondoPrimario}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de progreso del splash. -->
    <Style x:Key="BarraCarga" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Width" Value="220"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource Separador}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{DynamicResource Acento}" CornerRadius="2"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TarjetaPerfil" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Separador}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <Style x:Key="Aviso" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AvisoFondo}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Acento}"/>
        <Setter Property="BorderThickness" Value="4,0,0,0"/>
        <Setter Property="CornerRadius" Value="0,8,8,0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

</ResourceDictionary>
