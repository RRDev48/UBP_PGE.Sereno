<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo se usa para el ícono de la bandeja del sistema (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Se desactivan los using implícitos para evitar choques de nombres entre WPF y Windows Forms. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sereno</RootNamespace>
    <AssemblyName>Sereno</AssemblyName>
    <ApplicationIcon>Recursos\sereno.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Sereno</Product>
    <Description>Asistente de pausas para Windows. Módulo de acceso con perfiles locales.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Recursos\sereno.ico" />
  </ItemGroup>

</Project>
