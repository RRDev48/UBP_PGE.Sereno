<Application x:Class="Sereno.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- El primer diccionario se reemplaza por Oscuro.xaml si Windows usa tema oscuro. -->
                <ResourceDictionary Source="Temas/Claro.xaml"/>
                <ResourceDictionary Source="Temas/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
