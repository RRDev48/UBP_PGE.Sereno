<Window x:Class="Sereno.Vistas.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sereno" Style="{StaticResource VentanaSereno}" WindowStartupLocation="CenterScreen"
        Width="440" Height="300" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize"
        BorderBrush="{DynamicResource Separador}" BorderThickness="1"
        Icon="/Recursos/sereno.ico">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="96" Height="96" Margin="0,0,0,14">
                <Ellipse x:Name="Halo" Fill="{DynamicResource Halo}" Opacity="0.28" Margin="-6">
                    <Ellipse.Effect>
                        <BlurEffect Radius="28"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Path Data="{StaticResource GeoLuna}" Fill="{DynamicResource Acento}"
                      Width="52" Height="52" Stretch="Uniform"/>
            </Grid>

            <TextBlock Text="Sereno" FontFamily="{StaticResource FuenteTitulo}" FontSize="44"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Avisa, no interrumpe." FontFamily="{StaticResource FuenteTitulo}" FontStyle="Italic"
                       Foreground="{DynamicResource TextoSecundario}" HorizontalAlignment="Center"
                       Margin="0,6,0,22"/>

            <ProgressBar x:Name="Progreso" Style="{StaticResource BarraCarga}"
                         AutomationProperties.Name="Cargando Sereno"/>
            <TextBlock x:Name="EstadoTexto" FontSize="13" Foreground="{DynamicResource TextoSecundario}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       AutomationProperties.LiveSetting="Polite"/>

            <Button x:Name="Cerrar" Style="{StaticResource BotonSecundario}" Content="Cerrar"
                    HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"
                    Click="Cerrar_Click"/>
        </StackPanel>

        <TextBlock x:Name="VersionTexto" FontSize="12" Foreground="{DynamicResource TextoSecundario}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,10"/>
    </Grid>
</Window>
