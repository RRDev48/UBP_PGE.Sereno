<UserControl x:Class="Sereno.Controles.CampoContrasena"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Margin="0,0,0,14">
    <StackPanel>
        <TextBlock x:Name="EtiquetaTexto" Style="{StaticResource Etiqueta}"/>

        <Border x:Name="Marco" Style="{StaticResource MarcoCampo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="CajaOculta" Style="{StaticResource CajaContrasenaInterna}"
                             PasswordChanged="CajaOculta_PasswordChanged"/>
                <TextBox x:Name="CajaVisible" Style="{StaticResource CajaTextoInterna}" Visibility="Collapsed"
                         TextChanged="CajaVisible_TextChanged"/>
                <ToggleButton x:Name="Mostrar" Grid.Column="1" Style="{StaticResource BotonOjo}"
                              Checked="Mostrar_Checked" Unchecked="Mostrar_Unchecked"/>
            </Grid>
        </Border>

        <TextBlock x:Name="AyudaTexto" Style="{StaticResource Ayuda}" Visibility="Collapsed"/>

        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
            <Path Data="{StaticResource GeoAviso}" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{DynamicResource Error}" StrokeThickness="2" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" Margin="0,2,6,0"/>
            <TextBlock x:Name="ErrorTexto" Foreground="{DynamicResource Error}" FontSize="14"
                       TextWrapping="Wrap" MaxWidth="360"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </StackPanel>
</UserControl>
