<UserControl x:Class="Sereno.Controles.CampoTexto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Margin="0,0,0,14">
    <StackPanel>
        <TextBlock x:Name="EtiquetaTexto" Style="{StaticResource Etiqueta}"/>

        <Border x:Name="Marco" Style="{StaticResource MarcoCampo}">
            <TextBox x:Name="Caja" Style="{StaticResource CajaTextoInterna}" TextChanged="Caja_TextChanged"/>
        </Border>

        <TextBlock x:Name="AyudaTexto" Style="{StaticResource Ayuda}" Visibility="Collapsed"/>

        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
            <Path Data="{StaticResource GeoAviso}" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{DynamicResource Error}" StrokeThickness="2" StrokeEndLineCap="Round"
                  VerticalAlignment="Top" Margin="0,2,6,0"/>
            <TextBlock x:Name="ErrorTexto" Foreground="{DynamicResource Error}" FontSize="14"
                       TextWrapping="Wrap" MaxWidth="360"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
    </StackPanel>
</UserControl>
